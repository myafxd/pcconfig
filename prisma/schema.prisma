generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Component {
  id            String   @id @default(uuid())
  externalId    String   @unique
  name          String
  shortName     String
  link          String
  price         Float
  image         String
  
  type          String?
  componentType String

  power         Int?     
  wattage       Int?     
  socket        String?  
  ramType       String?  

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([componentType])
}